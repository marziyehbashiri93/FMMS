# ──────────────────────────────────────────────────────────────────────────────
# FMMS Environment Variables — Example
#
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.
# All variables here are required unless marked [optional].
# ──────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────

# Which settings module to load
# Options: config.settings.development | config.settings.staging | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode — must be False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection URL
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://fmms:fmms@localhost:5432/fmms

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection URL (used for cache and Celery result backend)
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────

# Celery broker URL (separate Redis DB from cache)
CELERY_BROKER_URL=redis://localhost:6379/1

# ── SAP Integration ───────────────────────────────────────────────────────────

# SAP server hostname or IP
# Example: https://sap-host.example.com:443
SAP_HOST=

# SAP client/mandant number
# Example: 100
SAP_CLIENT=

# SAP service account username
SAP_USER=

# SAP service account password
SAP_PASSWORD=

# SAP System ID (SID)
# Example: PRD
SAP_SYSTEM_ID=

# Maximum SAP retry attempts before marking transaction as EXHAUSTED
# Default: 3
SAP_MAX_RETRIES=3

# Exponential backoff multiplier for SAP retries (seconds)
# Default: 2.0 — waits 2s, 4s, 8s between retries
SAP_RETRY_BACKOFF_FACTOR=2.0

# SAP HTTP request timeout in seconds
# Default: 30
SAP_REQUEST_TIMEOUT=30

# ── Security ──────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins [optional in development]
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Force HTTPS redirect [set True in staging/production]
SECURE_SSL_REDIRECT=False

# ── Observability ─────────────────────────────────────────────────────────────

# Sentry DSN for error tracking [optional — leave blank to disable]
SENTRY_DSN=

# ── Email [optional in development] ──────────────────────────────────────────

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fmms.local
